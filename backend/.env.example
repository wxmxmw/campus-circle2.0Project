# Copy this file to `.env` and fill in your real values.

# Remote database password for the local-mysql profile
REMOTE_DB_PASSWORD=your-db-password

# OpenAI-compatible relay config
LLM_API_KEY=your-relay-token
LLM_BASE_URL=https://ai.dianhuomao.shop/v1
LLM_MODEL=【J-C】gemini-2.5-pro（3）

# Optional overrides
LLM_CONNECT_TIMEOUT_SECONDS=15
LLM_REQUEST_TIMEOUT_SECONDS=60
APP_REDIS_ENABLED=false
# LOCAL_REDIS_HOST=localhost
# LOCAL_REDIS_PORT=6379
# LOCAL_REDIS_PASSWORD=

# Optional fallback names also supported by the backend
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
