# Copy this file to `.env` and fill in your real values.

# Generate a unique value: openssl rand -base64 48
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes

# Uncomment for the local-mysql or prod profile.
# SPRING_PROFILES_ACTIVE=local-mysql
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/campus_circle
# SPRING_DATASOURCE_USERNAME=campus_dev
# SPRING_DATASOURCE_PASSWORD=replace-me

# OpenAI-compatible relay config
# LLM_API_KEY=replace-me
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini

# Optional overrides
LLM_CONNECT_TIMEOUT_SECONDS=15
LLM_REQUEST_TIMEOUT_SECONDS=60
APP_REDIS_ENABLED=false
# APP_CORS_ALLOWED_ORIGINS=http://localhost:8081
# APP_BOOTSTRAP_ADMIN_USERNAME=admin
# APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-chars
# LOCAL_REDIS_HOST=localhost
# LOCAL_REDIS_PORT=6379
# LOCAL_REDIS_PASSWORD=

# Optional fallback names also supported by the backend
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
